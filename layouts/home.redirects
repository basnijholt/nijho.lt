{{- $rules := slice }}
{{- range site.Pages }}
  {{- $target := .RelPermalink }}
  {{- range .Aliases }}
    {{- $rules = $rules | append (printf "%s%s %s 301" . (cond (path.Ext .) "" "/") $target) }}
  {{- end }}
{{- end }}
{{- range hugo.Data.redirects }}
  {{- $rules = $rules | append (printf "%s %s %d%s" .from .to (.status | default 301) (cond (.force | default false) "!" "")) }}
{{- end }}
{{- $images := newScratch }}
{{- range site.Pages }}
  {{- range .Resources.ByType "image" }}
    {{- $images.Add (path.Base .Name) (slice .) }}
  {{- end }}
{{- end }}
{{- range resources.Match "media/**" }}
  {{- $images.Add (path.Base .Name) (slice .) }}
{{- end }}
{{- range hugo.Data.old_images }}
  {{- $old := . }}
  {{- range $images.Get .file }}
    {{- if eq (len .Content) $old.size }}
      {{- $target := .RelPermalink }}
      {{- range $old.names }}
        {{- $rules = $rules | append (printf "%s/%s %s 301" (path.Dir $target) . $target) }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- range $rules }}
  {{- . }}
{{ end -}}
