{{- $rules := slice }}
{{- range site.Pages }}
  {{- $target := .RelPermalink }}
  {{- range .Aliases }}
    {{- $source := cond (strings.HasSuffix . ".html") . (printf "%s/" (strings.TrimSuffix "/" .)) }}
    {{- $rules = $rules | append (printf "%s %s 301" $source $target) }}
  {{- end }}
{{- end }}
{{- range hugo.Data.redirects }}
  {{- $rules = $rules | append (printf "%s %s %d" .from .to (.status | default 301)) }}
{{- end }}
{{- $images := newScratch }}
{{- range site.Pages }}
  {{- range .Resources.ByType "image" }}
    {{- $images.Add (path.Base .Name) (slice .) }}
  {{- end }}
{{- end }}
{{- range resources.Match "media/**" }}
  {{- $image := . }}
  {{- if strings.HasPrefix .Name "/media/albums/" }}
    {{- $image = partial "functions/album_original.html" . }}
  {{- end }}
  {{- $images.Add (path.Base .Name) (slice $image) }}
{{- end }}
{{- range hugo.Data.old_images }}
  {{- $old := . }}
  {{- range $images.Get .file }}
    {{- if eq (len .Content) $old.size }}
      {{- $target := .RelPermalink }}
      {{- range $old.names }}
        {{- $rules = $rules | append (printf "%s/%s %s 301" (path.Dir $target) . $target) }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- /* Cloudflare Pages applies a rule even where a page exists, matches trailing slashes literally, and counts every rule
       after the first one with a splat or a placeholder as dynamic (max 100). So a rule whose source is a page is left out,
       each trailing-slash static rule also emits a slashless counterpart, and dynamic rules go last. */}}
{{- $live := newScratch }}
{{- range site.Pages }}
  {{- range .OutputFormats }}
    {{- $live.Set .RelPermalink true }}
  {{- end }}
{{- end }}
{{- $seen := newScratch }}
{{- $static := slice }}
{{- $dynamic := slice }}
{{- range $rules }}
  {{- $parts := split . " " }}
  {{- $source := index $parts 0 }}
  {{- if findRE `\*|/:` $source }}
    {{- $dynamic = $dynamic | append . }}
  {{- else if and (not ($live.Get $source)) (not ($seen.Get $source)) }}
    {{- $seen.Set $source true }}
    {{- $static = $static | append . }}
    {{- if and (strings.HasSuffix $source "/") (ne $source "/") }}
      {{- $bare := strings.TrimSuffix "/" $source }}
      {{- if and (not ($live.Get $bare)) (not ($seen.Get $bare)) }}
        {{- $seen.Set $bare true }}
        {{- $static = $static | append (printf "%s %s %s" $bare (index $parts 1) (index $parts 2)) }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- range $static }}
  {{- . }}
{{ end -}}
{{- range $dynamic }}
  {{- . }}
{{ end -}}
