+
+
+class MinimalRunTools(Toolkit):
+    """Experiment only: present the canonical `run_shell_command` as minimal mode's single function.
+
+    The tool dialect then shows it in the model family's own shape, such as Claude Code's `Bash` or
+    Codex's `exec_command`, while execution keeps minimal Bash's response owner.
+    """
+
+    def __init__(
+        self,
+        *,
+        execute: Callable[[ToolKey, dict[str, object], FunctionCall], Awaitable[str | ToolResult]] | None = None,
+        on_prepare: Callable[[Function], None] | None = None,
+    ) -> None:
+        self._execute = execute
+        super().__init__(name="minimal_run", tools=[])
+        function = BashPresentationFunction.from_callable(self.run_shell_command)
+        assert isinstance(function, BashPresentationFunction)
+        # The dialect recognizes the canonical shell function by its name and toolkit.
+        function.owning_toolkit = "shell"
+        function.bind_preparation(on_prepare)
+        self.async_functions["run_shell_command"] = function
+        self.functions["run_shell_command"] = function
+
+    async def run_shell_command(
+        self,
+        args: str,
+        tail: int = 100,
+        timeout: int = DEFAULT_RUN_TIMEOUT_SECONDS,  # noqa: ASYNC109
+        workdir: str | None = None,
+        fc: FunctionCall | None = None,
+    ) -> str | ToolResult:
+        """Run a shell command with Bash and return its output."""
+        if not isinstance(args, str) or not args.strip():
+            msg = "run_shell_command requires a command"
+            raise ValueError(msg)
+        arguments: dict[str, object] = {"args": args, "timeout": timeout, "tail": tail}
+        if workdir is not None:
+            arguments["workdir"] = workdir
+        if self._execute is None or fc is None:
+            msg = "Bash requires an active response owner"
+            raise RuntimeError(msg)
+        return await self._execute(ToolKey("shell", "run_shell_command"), arguments, fc)
